#!/bin/zsh -f
set -euo pipefail

# Shared protected Pi/OMP entrypoint. Install the same file as `pi` and `omp`,
# earlier on PATH than either real binary.
#
# Security-critical assignments are readonly where zsh permits so ambient env or
# a compromised intermediate cannot re-point the protected entry.

typeset -r PI_SANDBOX_TRANSPARENT=1
typeset -r PI_SANDBOX=1
typeset -r PI_SANDBOX_RUNTIME="${0:A:t}"
case "$PI_SANDBOX_RUNTIME" in
  pi|omp) ;;
  *)
    print -u2 -- "[pi-sandbox-guard] unsupported launcher name '$PI_SANDBOX_RUNTIME'; expected pi or omp."
    exit 1
    ;;
esac
typeset -r PI_EXECUTABLE_KEY="$PI_SANDBOX_RUNTIME"
typeset -r PI_SANDBOX_SHIM_PATH="${0:A}"
typeset -r PI_SANDBOX_INSTALL_DIR="${0:A:h}"
typeset -r PI_SANDBOX_PROFILE="$PI_SANDBOX_INSTALL_DIR/pi-sandbox.sb"
typeset -r PREAMBLE="$PI_SANDBOX_INSTALL_DIR/pi-sandbox-preamble.zsh"

# OMP parses --profile inside the real binary, after Seatbelt parameters have
# already been fixed. Mirror the effective CLI value before sourcing the
# preamble so the sandbox and OMP derive the same state root.
if [ "$PI_SANDBOX_RUNTIME" = "omp" ]; then
  typeset -a _pi_sandbox_args
  typeset -i _pi_sandbox_i=1 _pi_sandbox_profile_args=0
  typeset _pi_sandbox_profile=""
  _pi_sandbox_args=("$@")
  if [ "${#_pi_sandbox_args}" -gt 0 ]; then
    case "${_pi_sandbox_args[1]}" in
      --profile)
        if [ "${#_pi_sandbox_args}" -lt 2 ] \
          || [ -z "${_pi_sandbox_args[2]}" ] \
          || [[ "${_pi_sandbox_args[2]}" = -* ]]; then
          print -u2 -- "[pi-sandbox-guard] --profile requires a non-flag value."
          exit 2
        fi
        _pi_sandbox_profile="${_pi_sandbox_args[2]}"
        _pi_sandbox_profile_args=2
        ;;
      --profile=*)
        _pi_sandbox_profile="${_pi_sandbox_args[1]#--profile=}"
        if [ -z "$_pi_sandbox_profile" ]; then
          print -u2 -- "[pi-sandbox-guard] --profile requires a value."
          exit 2
        fi
        _pi_sandbox_profile_args=1
        ;;
    esac
  fi
  _pi_sandbox_i=$((_pi_sandbox_profile_args + 1))
  while [ "$_pi_sandbox_i" -le "${#_pi_sandbox_args}" ]; do
    case "${_pi_sandbox_args[$_pi_sandbox_i]}" in
      --profile|--profile=*)
        print -u2 -- "[pi-sandbox-guard] protected OMP requires --profile to be the first argument and specified once."
        print -u2 -- "[pi-sandbox-guard] place it first or use OMP_PROFILE."
        exit 2
        ;;
    esac
    _pi_sandbox_i=$((_pi_sandbox_i + 1))
  done
  [ -n "$_pi_sandbox_profile" ] && export OMP_PROFILE="$_pi_sandbox_profile"
  unset _pi_sandbox_args _pi_sandbox_i _pi_sandbox_profile_args _pi_sandbox_profile
fi

if [ ! -f "$PREAMBLE" ]; then
  print -u2 -- "[pi-sandbox-guard] sandbox preamble missing ($PREAMBLE); refusing to launch."
  exit 1
fi

source "$PREAMBLE"

# Nested own-shim re-entry marker (paired with profile/boundary markers from preamble).
export PI_SANDBOX_SHIM_ACTIVE=1
export PI_SANDBOX_RUNTIME_ACTIVE="$PI_SANDBOX_RUNTIME"
# The digest is a coincidence check, not a secret. Behavioral probes verify the
# recorded project and active-hooks boundaries before nested pass-through.
if [ -n "${PI_SANDBOX_PROFILE_DIGEST:-}" ]; then
  export PI_SANDBOX_PROFILE_DIGEST
fi

# The extension is part of agent sessions, not the runtimes' administrative
# command parsers. Injecting it before a native subcommand changes Pi's command
# into a prompt and makes several OMP subcommands reject an unknown flag.
is_runtime_command() {
  local runtime="$1" arg=""
  shift
  while [ "$#" -gt 0 ]; do
    arg="$1"
    shift
    case "$arg" in
      --) return 1 ;;
      --profile|--cwd|--config|--add-dir)
        [ "$#" -gt 0 ] || return 1
        shift
        continue
        ;;
      --profile=*|--cwd=*|--config=*|--add-dir=*|--allow-home|--offline)
        continue
        ;;
      --alias|--alias=*|--export|--export=*|--list-models|--help|-h|--version|-v)
        return 0
        ;;
      -*) return 1 ;;
      *)
        case "$runtime:$arg" in
          pi:install|pi:remove|pi:uninstall|pi:update|pi:list|pi:config|pi:auth)
            return 0
            ;;
          omp:cleanse|omp:commit|omp:join)
            return 2
            ;;
          omp:agents|omp:auth-broker|omp:auth-gateway|omp:bench \
          |omp:browser-relay|omp:completions|omp:config \
          |omp:dry-balance|omp:gallery|omp:gc|omp:grep|omp:grievances|omp:install \
          |omp:models|omp:plugin|omp:read|omp:say|omp:search|omp:setup \
          |omp:shell|omp:ssh|omp:stats|omp:tiny-models|omp:token|omp:ttsr \
          |omp:update|omp:usage|omp:worktree)
            return 0
            ;;
        esac
        return 1
        ;;
    esac
  done
  return 1
}

if is_runtime_command "$PI_SANDBOX_RUNTIME" "$@"; then
  exec "${PI_SANDBOX_CMD[@]}" "${PI_LAUNCH_VECTOR[@]}" "$@"
else
  PI_SANDBOX_COMMAND_KIND="$?"
  if [ "$PI_SANDBOX_COMMAND_KIND" -eq 2 ]; then
    print -u2 -- "[pi-sandbox-guard] this OMP agent command does not accept the required guard extension; refusing protected launch."
    print -u2 -- "[pi-sandbox-guard] call the real OMP binary directly only when you intentionally accept guard-only/unsandboxed operation."
    exit 1
  fi
  unset PI_SANDBOX_COMMAND_KIND
fi

PI_SANDBOX_GUARD_EXTENSION="$PI_SANDBOX_INSTALL_DIR/pi-sandbox-guard-extension/index.ts"
if [ ! -f "$PI_SANDBOX_GUARD_EXTENSION" ]; then
  PI_SANDBOX_GUARD_EXTENSION="$HOME/.pi/agent/extensions/pi-sandbox-guard/index.ts"
fi
typeset -r PI_SANDBOX_GUARD_EXTENSION
if [ ! -f "$PI_SANDBOX_GUARD_EXTENSION" ]; then
  print -u2 -- "[pi-sandbox-guard] shared guard extension missing ($PI_SANDBOX_GUARD_EXTENSION); refusing to launch."
  exit 1
fi

PI_SANDBOX_GUARD_NODE_FILE="${PI_SANDBOX_GUARD_EXTENSION:h}/.guard-node"
if [ -f "$PI_SANDBOX_GUARD_NODE_FILE" ]; then
  PI_SANDBOX_GUARD_NODE=""
  IFS= read -r PI_SANDBOX_GUARD_NODE < "$PI_SANDBOX_GUARD_NODE_FILE" || true
  case "$PI_SANDBOX_GUARD_NODE" in
    /*) PI_SANDBOX_GUARD_NODE="${PI_SANDBOX_GUARD_NODE:A}" ;;
    *)
      print -u2 -- "[pi-sandbox-guard] invalid guard Node binding; refusing to launch."
      exit 1
      ;;
  esac
  if [ ! -x "$PI_SANDBOX_GUARD_NODE" ] || [ -d "$PI_SANDBOX_GUARD_NODE" ]; then
    print -u2 -- "[pi-sandbox-guard] stale guard Node binding; refusing to launch."
    exit 1
  fi
  if executable_under_sandbox_write_root \
       "$PI_SANDBOX_GUARD_NODE" "$HOME_CANON" "$PROJECT" "$TMPDIR_CANON"; then
    print -u2 -- "[pi-sandbox-guard] guard Node is inside a sandbox-writable root; refusing to launch."
    exit 1
  fi
fi
unset PI_SANDBOX_GUARD_NODE_FILE PI_SANDBOX_GUARD_NODE

# PI_LAUNCH_VECTOR is (executable) normally, or (interpreter executable) when the
# resolved target is a `node` shebang script and an interpreter was recorded. Execing
# the vector instead of "$PI_EXECUTABLE" is what makes a recorded interpreter real:
# otherwise the shebang would resolve `node` from the sanitized PATH, which has no
# entry for nvm/fnm/volta/asdf/mise installs.
exec "${PI_SANDBOX_CMD[@]}" "${PI_LAUNCH_VECTOR[@]}" \
  --extension "$PI_SANDBOX_GUARD_EXTENSION" "$@"
